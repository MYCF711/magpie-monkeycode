{
  "name": "magpie-monkeycode",
  "version": "0.2.3",
  "description": "MonkeyCode 国内站 / 国际站 + 百智云 magpie 插件：三家独立供应商，浏览器登录或 API Key 接入，网关签名与积分额度。",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "README-TEMPLATE.md",
    "AGENTS.md",
    "CHECKLIST.md",
    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "NOTICE.md",
    "LICENSE",
    "extract-contract.py",
    "registry-entry.json",
    "tests",
    "scripts",
    "examples",
    "ERROR-CODES.md",
    "GUIDE.md",
    "OFFICIAL-SOURCES.md",
    "SCORING.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "provider-plugin",
    "monkeycode",
    "monkeycode-ai",
    "baizhi",
    "baizhicloud",
    "checkin",
    "anthropic"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4,
    "name": "MonkeyCode 与百智云"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:errors": "node scripts/check-error-codes.mjs .",
    "release": "node scripts/release.mjs",
    "score": "node scripts/score.mjs",
    "maintenance": "node scripts/check-maintenance.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/magpie-monkeycode.git"
  },
  "bugs": {
    "url": "https://github.com/MYCF711/magpie-monkeycode/issues"
  },
